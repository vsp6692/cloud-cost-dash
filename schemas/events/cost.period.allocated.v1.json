{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloudledger.dev/events/cost.period.allocated.v1.json",
  "title": "dev.cloudledger.cost.period.allocated.v1",
  "description": "DRAFT. Producer: allocation. Idempotency key: tenant + period + data_version. Phase 15. See docs/contracts/EVENTS.md.",
  "x-phase": "15",
  "x-idempotency-key": "tenant + period + data_version",
  "allOf": [
    {
      "$ref": "cloudevent-envelope.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "dev.cloudledger.cost.period.allocated.v1"
    },
    "source": {
      "const": "cloudledger/allocation"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "billing_period",
        "data_version",
        "rule_set_version"
      ],
      "properties": {
        "billing_period": {
          "$ref": "cloudevent-envelope.v1.json#/$defs/billing_period"
        },
        "data_version": {
          "type": "integer"
        },
        "rule_set_version": {
          "type": "integer"
        },
        "unallocated": {
          "type": "array",
          "items": {
            "$ref": "cloudevent-envelope.v1.json#/$defs/money"
          }
        },
        "completed_at": {
          "$ref": "cloudevent-envelope.v1.json#/$defs/timestamp"
        }
      }
    }
  }
}
