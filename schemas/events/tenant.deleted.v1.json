{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloudledger.dev/events/tenant.deleted.v1.json",
  "title": "dev.cloudledger.tenant.deleted.v1",
  "description": "DRAFT. Producer: tenants. Idempotency key: tenant id. Phase 04. See docs/contracts/EVENTS.md.",
  "x-phase": "04",
  "x-idempotency-key": "tenant id",
  "allOf": [
    {
      "$ref": "cloudevent-envelope.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "dev.cloudledger.tenant.deleted.v1"
    },
    "source": {
      "const": "cloudledger/tenants"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "tenant_id",
        "deleted_at",
        "mode"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "cloudevent-envelope.v1.json#/$defs/id"
        },
        "mode": {
          "enum": [
            "pending_deletion",
            "purged"
          ]
        },
        "deleted_at": {
          "$ref": "cloudevent-envelope.v1.json#/$defs/timestamp"
        },
        "purge_after": {
          "$ref": "cloudevent-envelope.v1.json#/$defs/timestamp"
        }
      }
    }
  }
}
