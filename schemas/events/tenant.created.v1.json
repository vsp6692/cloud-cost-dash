{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cloudledger.dev/events/tenant.created.v1.json",
  "title": "dev.cloudledger.tenant.created.v1",
  "description": "DRAFT. Producer: tenants. Idempotency key: tenant id. Phase 04. See docs/contracts/EVENTS.md.",
  "x-phase": "04",
  "x-idempotency-key": "tenant id",
  "allOf": [
    {
      "$ref": "cloudevent-envelope.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "dev.cloudledger.tenant.created.v1"
    },
    "source": {
      "const": "cloudledger/tenants"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "tenant_id",
        "slug",
        "kind",
        "created_at"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "cloudevent-envelope.v1.json#/$defs/id"
        },
        "slug": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "individual",
            "organization"
          ]
        },
        "parent_tenant_id": {
          "anyOf": [
            {
              "$ref": "cloudevent-envelope.v1.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "data_region": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "$ref": "cloudevent-envelope.v1.json#/$defs/timestamp"
        }
      }
    }
  }
}
